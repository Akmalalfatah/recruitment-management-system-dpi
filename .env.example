# Copy this file to .env and fill in your Supabase project credentials.
# Get these from: Supabase Dashboard -> Project Settings -> API
#
# If you leave these blank / don't create a .env file, the app automatically
# runs in local Demo Mode (data stored in your browser's localStorage) so you
# can click through the whole system before Supabase is connected.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
